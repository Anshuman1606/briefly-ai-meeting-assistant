# For a hosted pilot. Copy into Streamlit Community Cloud Advanced settings.
# Locally use ignored .streamlit/secrets.toml. Never commit real secrets.
# All root settings must appear before a [table].
APP_ENV = "production"
DATABASE_URL = "postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/briefly?sslmode=require"
AUTH_MODE = "password"
ALLOW_SIGNUP = false
BRIEFLY_EMBEDDED_WORKER = true

# Optional generative analysis; leave unset for labeled extractive processing.
# MISTRAL_API_KEY = "replace-with-your-provider-key"
# MISTRAL_MODEL = "mistral-small-latest"

# Choose disabled, sarvam (Hindi/Hinglish PCM WAV), or whisper (optional package).
TRANSCRIPTION_BACKEND = "disabled"
# SARVAM_API_KEY = "replace-with-your-provider-key"
# SARVAM_MODEL = "saaras:v3"
# WHISPER_MODEL = "small"
# WHISPER_ALLOW_DOWNLOAD = false
# WHISPER_DEVICE = "cpu"
# WHISPER_COMPUTE_TYPE = "int8"

# For a team pilot, change AUTH_MODE above to "oidc" and configure every field.
# OIDC_ALLOWED_DOMAINS = "your-company.example"
# [auth]
# redirect_uri = "https://ACTUAL-APP.streamlit.app/oauth2callback"
# cookie_secret = "replace-with-a-strong-random-secret"
# client_id = "replace-with-your-identity-provider-client-id"
# client_secret = "replace-with-your-identity-provider-client-secret"
# server_metadata_url = "https://IDENTITY-PROVIDER/.well-known/openid-configuration"
